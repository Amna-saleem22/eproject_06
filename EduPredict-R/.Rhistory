install.packages("shiny")
install.packages("shinydashboard")
install.packages("ggplot2")
library(shiny)
library(shinydashboard)
library(ggplot2)
# 1. Dataset Load Karein (Jo aapki baki files se generate hua)
if (file.exists("Final_Student_Dataset.csv")) {
student_data <- read.csv("Final_Student_Dataset.csv")
} else {
# Agar file na ho to test karne ke liye dummy data (Class aur Name ke sath)
student_data <- data.frame(
Student_ID = c("S101", "S102", "S103", "S104", "S105", "S106"),
Name = c("Amna", "Ali", "Zain", "Sara", "Hamza", "Ayesha"),
Class = c("Maths", "Maths", "Maths", "Science", "Science", "Science"),
Attendance = c(85, 60, 90, 45, 78, 88),
Grade = c("A", "C", "A", "F", "B", "A"),
Status = c("Safe", "Risk", "Safe", "Dropout", "Safe", "Safe"),
stringsAsFactors = FALSE
)
}
# 2. Login Details Table (User, Password, Role, aur konsi Class belong karte hain)
users_db <- data.frame(
username = c("admin", "teacher_math", "teacher_science", "S101"),
password = c("admin123", "math123", "science123", "amna123"),
role = c("Admin", "Teacher", "Teacher", "Student"),
assigned_class = c("All", "Maths", "Science", "S101"), # Yeh filtering ke liye hai
stringsAsFactors = FALSE
)
# 3. USER INTERFACE (UI)
ui <- dashboardPage(
dashboardHeader(title = "EduPredict Framework"),
dashboardSidebar(
sidebarMenu(
id = "tabs",
menuItem("Dashboard Analytics", tabName = "dashboard", icon = icon("dashboard")),
menuItem("Student Data View", tabName = "data_table", icon = icon("table"))
)
),
dashboardBody(
tags$head(tags$style(HTML(".login-box { width: 400px; margin: 100px auto; padding: 20px; background: #f4f6f9; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }"))),
uiOutput("page_content")
)
)
# 4. SERVER LOGIC (Yahan filtering hoti hai)
server <- function(input, output, session) {
USER <- reactiveValues(Logged = FALSE, Role = NULL, Name = NULL, AssignedClass = NULL)
# Login Window UI
login_ui <- function() {
div(class = "login-box",
h2("EduPredict Login", align = "center", style = "color: #3c8dbc; font-weight: bold;"),
textInput("userName", "Username / Student ID:"),
passwordInput("password", "Password:"),
br(),
actionButton("login_btn", "Log In", class = "btn-primary btn-block"),
uiOutput("error_msg")
)
}
# Login check panel
observeEvent(input$login_btn, {
row_match <- users_db[users_db$username == input$userName & users_db$password == input$password, ]
if (nrow(row_match) == 1) {
USER$Logged <- TRUE
USER$Role <- row_match$role
USER$Name <- row_match$username
USER$AssignedClass <- row_match$assigned_class
} else {
output$error_msg <- renderUI({ p("Galat details! Check karein.", style = "color: red; margin-top: 10px;") })
}
})
# Reactive Data Filtering (Yeh automatically data kaat leta hai role ke hisab se)
filtered_data <- reactive({
req(USER$Logged)
if (USER$Role == "Admin") {
return(student_data) # Admin ko poora school dikhao
} else if (USER$Role == "Teacher") {
return(subset(student_data, Class == USER$AssignedClass)) # Teacher ko sirf unki class dikhao
} else if (USER$Role == "Student") {
return(subset(student_data, Student_ID == USER$AssignedClass)) # Student ko sirf uska apna row dikhao
}
})
# Main Content Control
output$page_content <- renderUI({
if (USER$Logged == FALSE) return(login_ui())
fluidPage(
h2(paste("Welcome,", USER$Name, paste0("(", USER$Role, " View)")), style = "color: #2c3e50;"),
actionButton("logout_btn", "Logout", class = "btn-danger", style = "float: right; margin-top: -45px;"),
br(),
tabItems(
# Tab 1: Dashboard Graphs
tabItem(tabName = "dashboard",
if (USER$Role %in% c("Admin", "Teacher")) {
fluidRow(
box(title = paste("Attendance Analytics -", USER$AssignedClass), status = "primary", solidHeader = TRUE, width = 6, plotOutput("attendance_plot")),
box(title = paste("Risk Status -", USER$AssignedClass), status = "warning", solidHeader = TRUE, width = 6, plotOutput("status_plot"))
)
} else {
# Student Dashboad View
fluidRow(
box(title = "Your Personal Academic Status", status = "info", solidHeader = TRUE, width = 12,
h3(paste("Student Name:", filtered_data()$Name)),
h4(paste("Your Attendance:", filtered_data()$Attendance, "%")),
h4(paste("Predicted Risk Status:"), style = "font-weight: bold;"),
h2(filtered_data()$Status, style = if(filtered_data()$Status == "Safe") "color: green;" else "color: red;")
)
)
}
),
# Tab 2: Data Table
tabItem(tabName = "data_table",
fluidRow(
box(title = "Filtered Student Records", status = "primary", solidHeader = TRUE, width = 12, dataTableOutput("student_table"))
)
)
)
)
})
# Logout Trigger
observeEvent(input$logout_btn, { USER$Logged <- FALSE; updateTextInput(session, "userName", value = ""); updatePasswordInput(session, "password", value = "") })
# ---- GRAPHS GENERATION (Aapke sawal ka jawab: Yeh graphs filter ho kar bante hain) ----
output$attendance_plot <- renderPlot({
data_to_plot <- filtered_data()
ggplot(data_to_plot, aes(x = Name, y = Attendance, fill = Name)) +
geom_bar(stat = "identity") + theme_minimal() + labs(title = "Class Attendance Level", y = "Attendance %")
})
output$status_plot <- renderPlot({
data_to_plot <- filtered_data()
ggplot(data_to_plot, aes(x = Status, fill = Status)) +
geom_bar() + theme_minimal() + labs(title = "Risk Count Analysis", y = "Number of Students")
})
output$student_table <- renderDataTable({ filtered_data() })
}
shinyApp(ui, server)
runApp('D:/semester6 project/EduPredict-R')
